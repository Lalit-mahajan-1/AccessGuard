generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  name                String?
  password            String?
  provider            AuthProvider @default(LOCAL)
  providerId          String?

  resetPasswordToken  String?
  resetPasswordExpire DateTime?

  projects            Project[]    // 🔹 new relation
  audits              Audit[]      // 🔹 new relation
  actionItems         ActionItem[] // 🔹 new relation

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Project {
  id             String   @id @default(uuid())
  githubRepo     String   // e.g. https://github.com/user/repo
  prodLink       String   // e.g. https://myapp.com
  meta           Json?    // Stores detect response metadata (type, projects, etc.)
  tree           Json?    // Stores repository file tree list

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  audits         Audit[]  // 🔹 new relation
  actionItems    ActionItem[] // 🔹 new relation

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Audit {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prodLink   String
  response   Json     // Stores play audit response JSON
  actionItems ActionItem[] // 🔹 new relation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActionItem {
  id        String   @id @default(uuid())
  task      String
  file      String
  type      String   // e.g. "accessibility", "security", "performance", "seo"
  priority  String   // e.g. "critical", "high", "medium", "low"
  issue     String
  fix       String
  status    String   @default("pending") // e.g. "pending", "in-progress", "completed"

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId   String
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}